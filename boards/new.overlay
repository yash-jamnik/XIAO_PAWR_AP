/ {
	chosen {
		zephyr,uart_console = &uart30;
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
		zephyr,uart-mcumgr = &uart21;
		nordic,pm-ext-flash = &gd25wq64;
	};
};

&uart30 {
	status = "okay";
	current-speed = <115200>;
};

&uart30_default {
	group1 {
		psels = <NRF_PSEL(UART_RTS, 0, 0)>, <NRF_PSEL(UART_TX, 0, 2)>;
	};
};

&uart30_sleep {
	group1 {
		psels = <NRF_PSEL(UART_RTS, 0, 0)>, <NRF_PSEL(UART_TX, 0, 2)>,
			<NRF_PSEL(UART_RX, 0, 3)>, <NRF_PSEL(UART_CTS, 0, 1)>;
	};
};

&uart30_default {
	group2 {
		psels = <NRF_PSEL(UART_RX, 0, 3)>, <NRF_PSEL(UART_CTS, 0, 1)>;
	};
};

&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;  // MISO pin
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			// low-power-enable;
		};
	};
};

// Enable SPI0 interface
&spi00 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 6 GPIO_ACTIVE_LOW>;

	gd25wq64: gd25wq64@0 {
		compatible = "jedec,spi-nor";
		status = "okay";

		reg = <0>;  /* first CS → P2.05 */

		spi-max-frequency = <32000000>;
		jedec-id = [c8 65 17];
		size = <0x4000000>;  /* 8MB */
		label = "LITTLEFS_FLASH";
		wp-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;
		hold-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
	};
};


&pinctrl {
	uart21_default: uart21_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 7)>;
		};
	};

	uart21_sleep: uart21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>, <NRF_PSEL(UART_RX, 1, 7)>;
		};
	};
};

&uart21 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart21_default>;
	pinctrl-1 = <&uart21_sleep>;
	pinctrl-names = "default", "sleep";
};


&uart20{
	status = "disabled";
};
